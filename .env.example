# Helmet Detection System - Environment Configuration

# Model Paths
HELMET_MODEL_PATH=./helmet_model.pt
PLATE_MODEL_PATH=./plate_model.pt
TRAFFIC_MODEL_PATH=./traffic_model.pt
YOLO_DEFAULT_MODEL=yolov8n.pt

# Enable/Disable Features (1 = enabled, 0 = disabled)
ENABLE_IMAGE_PLATE_OCR=1
ENABLE_VIDEO_PLATE_OCR=1
ENABLE_WEBCAM_PLATE_OCR=1
ENABLE_IMAGE_FULL_FRAME_FALLBACK=1

# Performance Tuning
FRAME_SAMPLE_INTERVAL=8              # Process every Nth frame in video/webcam
MAX_VEHICLE_CROPS=1                  # Max vehicles to process per frame
MAX_INFERENCE_DIM=640                # Max inference dimension (smaller = faster)
YOLO_IMAGE_SIZE=480                  # YOLO input size (smaller = faster)
OCR_VARIANT_LIMIT=1                  # OCR variants to try per plate
IMAGE_CACHE_SIZE=32                  # Number of images to cache results for
MAX_PLATE_REGION_PROPOSALS=3         # Max plate regions to search

# Flask Server
FLASK_PORT=5004
FLASK_DEBUG=True
